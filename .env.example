# Public project values from Supabase Dashboard -> Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The public origin of this deployment, without a trailing slash.
# Local development safely defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-simplify-domain.example

# Server-only Supabase secret (or legacy service-role credential) for account deletion.
# Never prefix this key with NEXT_PUBLIC_. Do not commit the real credential.
SUPABASE_SECRET_KEY=

# Public legal facts are configured in src/lib/legal/operator.json.
# Deploy through npm run build:production; unresolved facts fail that check.
